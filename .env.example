# 複製為 .env 後依需求修改：cp .env.example .env
# docker compose 與 apps/worker 都會讀取根目錄的 .env

# ── Database ─────────────────────────────────────────────
# Docker 內 PostgreSQL 16 映射到 host 的埠號（預設 5433，避開本機既有的 5432）
POSTGRES_PORT=5433
DATABASE_URL=postgres://aeh:aeh@localhost:5433/anime_event_hub
# 整合測試用 DB（docker/postgres/init 會一併建立）
DATABASE_URL_TEST=postgres://aeh:aeh@localhost:5433/anime_event_hub_test

# ── Crawler ──────────────────────────────────────────────
# UA 需標示專案名稱與聯絡方式（tech-spec R13）；不要把個人資料寫進程式碼，放在這裡
CRAWL_USER_AGENT="AnimeEventHubTW-Bot/0.1 (+https://example.invalid/contact)"
# 同一 host 最小請求間隔（毫秒），規格要求 >= 3000
CRAWL_MIN_INTERVAL_MS=3000
# 原始快照存放目錄（相對路徑以 repo 根目錄為基準），保留 30 天
SNAPSHOT_DIR=./var/snapshots

# ── Alerts ───────────────────────────────────────────────
# Slack Incoming Webhook；留空時告警降級為 log（本機/測試預設）
SLACK_WEBHOOK_URL=

# ── Admin (/admin 審核後台 Basic Auth，格式 user:password) ──
ADMIN_BASIC_AUTH=admin:change-me

# ── Runtime ──────────────────────────────────────────────
TZ=Asia/Taipei
LOG_LEVEL=info
