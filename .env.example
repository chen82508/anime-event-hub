# 複製為 .env 後依需求修改：cp .env.example .env
# docker compose 與 apps/worker 都會讀取根目錄的 .env

# ── Database ─────────────────────────────────────────────
# Docker 內 PostgreSQL 16 映射到 host 的埠號（預設 5433，避開本機既有的 5432）
POSTGRES_PORT=5433
DATABASE_URL=postgres://aeh:aeh@localhost:5433/anime_event_hub
# 經 transaction 模式的 pooler 連線時設為 false（停用具名 prepared statement），
# 例如 Vercel 部署使用 Neon 的 -pooler 連線字串。本機與直連 DB 留空（= true）
DATABASE_PREPARE=
# 整合測試用 DB（docker/postgres/init 會一併建立）
DATABASE_URL_TEST=postgres://aeh:aeh@localhost:5433/anime_event_hub_test

# ── Crawler ──────────────────────────────────────────────
# UA 需標示專案名稱與聯絡方式（tech-spec R13）；不要把個人資料寫進程式碼，放在這裡
CRAWL_USER_AGENT="AnimeEventHubTW-Bot/0.1 (+https://example.invalid/contact)"
# 同一 host 最小請求間隔（毫秒），規格要求 >= 3000
CRAWL_MIN_INTERVAL_MS=3000
# 原始快照存放目錄（相對路徑以 repo 根目錄為基準），保留 30 天
SNAPSHOT_DIR=./var/snapshots

# ── Alerts ───────────────────────────────────────────────
# Slack Incoming Webhook；留空時告警降級為 log（本機/測試預設）
SLACK_WEBHOOK_URL=
# console = 只寫 log；slack = 送 webhook（需 SLACK_WEBHOOK_URL）。留空：有 webhook 用 slack，否則 console
ALERT_MODE=
# 連續 N 次 0 筆告警、同一告警節流（分鐘）、缺漏率突增門檻（0–1）
ALERT_EMPTY_RUN_THRESHOLD=3
ALERT_THROTTLE_MINUTES=360
ALERT_MISSING_RATE_JUMP=0.3

# ── Pipeline 門檻（PoC 後校正，tech-spec R15）────────────
# KKTIX 搜尋關鍵字（逗號分隔，留空用預設：動漫,動畫,聲優,同人,cosplay）
KKTIX_KEYWORDS=
# KKTIX 規模門檻：場館不在字典時，票價上限需達此值（留空 = 不看票價）
KKTIX_MIN_PRICE_MAX=1000
# KKTIX 規模門檻：場館不在字典時，命中作品/聲優/歌手標籤也算達門檻（true/false）
KKTIX_TAG_PASSES=true
# 去重灰色區間下限（pg_trgm similarity）與開始日期容許差距（天）
DEDUP_POSSIBLE_MIN=0.45
DEDUP_DATE_WINDOW_DAYS=1
# 快照保留天數（≤ 30）
SNAPSHOT_RETENTION_DAYS=30

# ── 排程（node-cron，Asia/Taipei）────────────────────────
CRON_DAILY="0 4 * * *"
CRON_WEEKLY="0 5 * * 1"
CRON_CLEANUP="30 3 * * *"

# ── 訂閱與推播（Phase 3）────────────────────────────────
# console = 本機模擬：推播內容只寫到 worker log、投遞標為 simulated（預設，不需任何金鑰）
# live    = 實際送出；缺金鑰的管道仍會退回模擬並在啟動時警告
NOTIFY_MODE=console
# 通知內的連結網址（LINE 訊息會附完整網址）
PUBLIC_BASE_URL=http://localhost:3000
# Web Push（VAPID）：執行 `pnpm --filter @aeh/worker cli vapid` 產生；三者需同時設定
# 本機 http://localhost 也能測試瀏覽器推播（瀏覽器視 localhost 為安全來源）
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
# LINE 官方帳號（Messaging API）：LINE Developers 後台取得；webhook 設為 <網址>/api/line/webhook
# 未設定時網站的 LINE 區塊只提供本機模擬綁定（console 模式且非 production）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 加好友連結用的官方帳號 ID（例如 @123abcde）
LINE_OFFICIAL_ACCOUNT_ID=
# 勿擾時段（台灣時間，起-迄小時；留空 = 不限）：期間的推播延到結束時送出
NOTIFY_QUIET_HOURS=23-8
# 收藏提醒：開賣前幾小時、活動前一天幾點（台灣時間）
NOTIFY_SALE_LEAD_HOURS=24
NOTIFY_EVENT_REMINDER_HOUR=18
# 一次比對命中超過 N 個新活動時合併成一則摘要
NOTIFY_DIGEST_THRESHOLD=3
# 站內通知保留天數
NOTIFICATION_RETENTION_DAYS=90
# notify 排程（新活動比對、提醒、投遞）
CRON_NOTIFY="*/5 * * * *"

# ── Admin (/admin 審核後台 Basic Auth，格式 user:password) ──
ADMIN_BASIC_AUTH=admin:change-me

# ── Runtime ──────────────────────────────────────────────
TZ=Asia/Taipei
LOG_LEVEL=info
