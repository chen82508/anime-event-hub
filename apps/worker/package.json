{
  "name": "@aeh/worker",
  "version": "0.0.0",
  "private": true,
  "description": "排程 + CLI（crawl / reparse / dedup / cleanup）；單一 process 序列執行",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/scheduler.ts",
    "start": "tsx src/scheduler.ts",
    "cli": "tsx src/cli.ts",
    "crawl": "tsx src/cli.ts crawl",
    "reparse": "tsx src/cli.ts reparse",
    "typecheck": "tsc",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aeh/core": "workspace:*",
    "@aeh/db": "workspace:*",
    "@aeh/dedup": "workspace:*",
    "@aeh/http": "workspace:*",
    "@aeh/normalize": "workspace:*",
    "@aeh/scrapers": "workspace:*",
    "@aeh/tagger": "workspace:*",
    "node-cron": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
